# ═══════════════════════════════════════════════════════════════
# SecureMeet - Railway Production Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy these to Railway environment variables dashboard

# ── Environment ──────────────────────────────────────────────────
NODE_ENV=production

# ── Server (Railway auto-sets PORT, use 0.0.0.0 for HOST) ───────
# PORT is automatically set by Railway
HOST=0.0.0.0

# ── Google OAuth (REQUIRED - Get from Google Cloud Console) ─────
GOOGLE_CLIENT_ID=176918613650-qiikg1v93s8u9bk02vp9nrfcmibi5k56.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
# IMPORTANT: Update this to your Railway backend URL after deployment
GOOGLE_REDIRECT_URI=https://your-backend-app.railway.app/api/auth/google/callback

# ── MongoDB (REQUIRED - Use MongoDB Atlas) ───────────────────────
MONGODB_URI=mongodb+srv://RayandNova:YOUR_PASSWORD@cluster0.jgu9ust.mongodb.net/securemeet

# ── Session Security (REQUIRED - Use a strong random key) ────────
SESSION_SECRET=your-production-secret-change-this-to-random-64-char-string

# ── Razorpay Payments (Optional - for subscription features) ─────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Gemini AI (Optional - enables translation & memo) ────────────
GEMINI_API_KEY=

# ── Python AI Service (Optional - leave empty if not deploying) ──
# PYTHON_AI_URL=https://your-python-ai-service.railway.app

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=info
