# ═══════════════════════════════════════════════════════════════
# SecureMeet Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Do not commit real credentials. Configure these as environment variables in production.

# ── Google OAuth (Required for authentication) ──────────────────
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Must exactly match an Authorized redirect URI in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ── MongoDB (Required for user profiles, meetings, subscriptions) ─
MONGODB_URI=mongodb://localhost:27017/securemeet
# Or use MongoDB Atlas: mongodb+srv://user:pass@cluster.mongodb.net/securemeet

# ── Session Security (Required for HMAC signing) ─────────────────
SESSION_SECRET=your-super-secret-hmac-key-change-this-in-production

# ── Razorpay Payments (Required for subscription features) ───────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── Gemini AI (Optional - enables translation & memo features) ───
GEMINI_API_KEY=your-google-gemini-api-key

# ── Server Configuration (Optional) ──────────────────────────────
PORT=3000
HOST=0.0.0.0

# ── Frontend & CORS Configuration (For Vercel + Railway Deployment) ─
FRONTEND_URL=https://securemeet-privatedoc.vercel.app
ALLOWED_ORIGINS=https://securemeet-privatedoc.vercel.app,http://localhost:5173,http://localhost:3000

